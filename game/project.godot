; Engine configuration file.

config_version=5

[application]

config/name="One Four Seven"
config/name.ios="147"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icons/icon.png"

[autoload]

Log="*res://scripts/autoload/log.gd"
Params="*res://scripts/autoload/params.gd"
Link="*res://scripts/autoload/link.gd"
Harness="*res://scripts/autoload/harness.gd"
Perf="*res://scripts/autoload/perf.gd"

[display]

window/size/viewport_width=1912
window/size/viewport_height=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2

[debug]

gdscript/warnings/untyped_declaration=2
