class_name TableAudio
extends Node3D
## Table sounds (spec 13.2): ball clicks, cushion hits, pocket drops and rattles, the tip, the
## miscue and a faint roll, each from the event's place on the table so they pan with the camera,
## louder and brighter with impact speed, never twice the same. Volume follows
## Settings "volume"; everything plays on the Master bus.
##
## The sounds are generated by tools/make_sounds.py. Voices are capped: when every one is busy
## (a break-off lands a dozen clicks at once) the quietest is stolen, or the new sound dropped
## when it would be the quietest itself.

## Emitted for every sound started, with its sound name ("click", "tip", ...) and settings.
signal sound_played(sound: String, volume_db: float, pitch_scale: float, at: Vector3)

const SOUND_DIR := "res://audio"
const SOUNDS := {
	"tip": ["tip_1", "tip_2", "tip_3"],
	"miscue": ["miscue"],
	"click": ["ball_click_1", "ball_click_2", "ball_click_3", "ball_click_4"],
	"cushion": ["cushion_1", "cushion_2", "cushion_3"],
	"jaw": ["jaw_1", "jaw_2"],
	"pocket": ["pocket_1", "pocket_2", "pocket_3"],
}
const ROLL_SOUND := "roll_loop"
const KIND_SOUNDS := {
	"strike": "tip",
	"ball_ball": "click",
	"ball_line": "cushion",
	"ball_arc": "jaw",
	"pocket": "pocket",
}
const VOICES := 12
## Below this the event is a resting contact, not a hit.
const MIN_SPEED := 0.02
const RANDOM_DB := 1.5
const RANDOM_PITCH := 0.04
## Each sound's level at its full speed (m/s), before Settings "volume". Below that speed the
## amplitude goes as speed^0.75 (15 dB a decade); above it, 5 dB a decade, so a break-off
## doesn't clip.
const LEVEL_DB := {"tip": -8.0, "miscue": -8.0, "click": -8.0, "cushion": -10.0, "jaw": -10.0, "pocket": -10.0}
const FULL_SPEED := {"tip": 8.0, "miscue": 4.0, "click": 6.0, "cushion": 4.0, "jaw": 3.0, "pocket": 3.0}
## A potted ball falls onto the leather however slowly it crept in.
const POCKET_DROP_SPEED := 0.6
const ROLL_MAX_DB := -24.0
const ROLL_FULL_SPEED := 4.0
const SILENT_DB := -80.0
const ROLL_SMOOTH_S := 0.05
const DEFAULT_BALL_RADIUS := 0.02625
## Close to the camera the inverse-distance gain would push hits past full scale.
const MAX_DB := 3.0
const UNIT_SIZE := 2.5

static var _streams_by_name := {}
static var _load_failed := {}

var rng := RandomNumberGenerator.new()

var _voices: Array[AudioStreamPlayer3D] = []
var _voice_db := PackedFloat64Array()
var _voice_end_usec := PackedInt64Array()
var _roll: AudioStreamPlayer3D
var _roll_target_db := SILENT_DB
var _roll_amp := 0.0
var _miscue := false
var _facing_lines := {}
var _height := DEFAULT_BALL_RADIUS
var _bad_event_logged := false


func _ready() -> void:
	for i in VOICES:
		var player := _make_player("Voice%d" % i)
		_voices.append(player)
	_voice_db.resize(VOICES)
	_voice_end_usec.resize(VOICES)
	_voice_end_usec.fill(0)
	_roll = _make_player("Roll")
	_roll.stream = _stream(ROLL_SOUND)
	for sound: String in SOUNDS:
		for file: String in SOUNDS[sound]:
			_stream(file)
	var dims := OfsTable.dimensions()
	if dims.has("ball_radius"):
		_height = float(dims["ball_radius"])
	use_table_shape(Physics.table_shape())
	set_process(false)


# Runs only while the roll sounds or fades: on_frame starts it, silence stops it.
func _process(delta: float) -> void:
	if _roll == null:
		set_process(false)
		return
	var target := db_to_linear(_roll_target_db) if _roll_target_db > SILENT_DB else 0.0
	_roll_amp += (target - _roll_amp) * (1.0 - exp(-delta / ROLL_SMOOTH_S))
	if target == 0.0 and _roll_amp < db_to_linear(SILENT_DB + 10.0):
		_roll_amp = 0.0
		if _roll.playing:
			_roll.stop()
		set_process(false)
		return
	_roll.volume_db = linear_to_db(_roll_amp)
	if not _roll.playing and _roll.stream != null:
		_roll.play()


## The strike event doesn't say whether the shot miscued: call this with the shot's
## OfsShotRecord.strike_outcome() before playing it.
func begin_shot(strike_outcome: Dictionary) -> void:
	_miscue = bool(strike_outcome.get("miscue", false))


## Hits on a pocket facing (OfsPhysics.table_shape() lines of kind "facing") sound like the jaw.
func use_table_shape(shape: Dictionary) -> void:
	_facing_lines.clear()
	var lines: Array = shape.get("lines", [])
	for i in lines.size():
		if (lines[i] as Dictionary).get("kind", "") == "facing":
			_facing_lines[i] = true


func on_event(event: Dictionary, state: PackedFloat64Array) -> void:
	var sound := sound_for(event)
	if String(event.get("kind", "")) == "strike":
		_miscue = false
	if sound.is_empty():
		return
	var speed := float(event.get("speed", 0.0))
	if speed < MIN_SPEED and sound != "pocket":
		return
	var variants: Array[AudioStream] = []
	for file: String in SOUNDS[sound]:
		var stream := _stream(file)
		if stream != null:
			variants.append(stream)
	var volume := _volume()
	if variants.is_empty() or volume <= 0.0:
		return
	var db := volume_db_for(sound, speed) + linear_to_db(volume) + rng.randf_range(-RANDOM_DB, RANDOM_DB)
	var voice := _pick_voice(db)
	if voice < 0:
		return
	var player := _voices[voice]
	player.stream = variants[rng.randi() % variants.size()]
	player.volume_db = db
	player.pitch_scale = pitch_for(sound, speed) * (1.0 + rng.randf_range(-RANDOM_PITCH, RANDOM_PITCH))
	player.position = _event_position(event, state, sound)
	player.play()
	_voice_db[voice] = db
	_voice_end_usec[voice] = Time.get_ticks_usec() + int(player.stream.get_length() / player.pitch_scale * 1e6)
	sound_played.emit(sound, db, player.pitch_scale, player.position)


## The rolling sound follows the moving balls.
func on_frame(state: PackedFloat64Array, _t: float, _dt: float) -> void:
	var fastest := -1
	var top := 0.0
	for i in state.size() / ShotPlayback.STRIDE:
		var base := i * ShotPlayback.STRIDE
		var motion := int(state[base + ShotPlayback.MOTION])
		if motion != ShotPlayback.SLIDING and motion != ShotPlayback.ROLLING:
			continue
		var speed := Vector2(state[base + ShotPlayback.VX], state[base + ShotPlayback.VY]).length()
		if speed > top:
			top = speed
			fastest = i
	var volume := _volume()
	if fastest < 0 or top < MIN_SPEED or volume <= 0.0:
		_roll_target_db = SILENT_DB
		return
	_roll_target_db = roll_db_for(top) + linear_to_db(volume)
	set_process(true)
	_roll.pitch_scale = 0.85 + 0.3 * clampf(top / ROLL_FULL_SPEED, 0.0, 1.0)
	var base := fastest * ShotPlayback.STRIDE
	_roll.position = TableSpace.core_to_godot(state[base + ShotPlayback.X], state[base + ShotPlayback.Y], _height)


func stop_all() -> void:
	for player in _voices:
		player.stop()
	_voice_end_usec.fill(0)
	_roll_target_db = SILENT_DB
	_roll_amp = 0.0
	if _roll != null:
		_roll.stop()
	set_process(false)


## The sound an event makes ("" for none): strike is "tip", or "miscue" after begin_shot said so.
func sound_for(event: Dictionary) -> String:
	var kind := String(event.get("kind", ""))
	if kind == "strike" and _miscue:
		return "miscue"
	if kind == "ball_line" and _facing_lines.has(int(event.get("body", -1))):
		return "jaw"
	return KIND_SOUNDS.get(kind, "")


## Level in dB before Settings "volume" for a sound name or event kind at an impact speed (m/s).
## Never decreases with speed.
static func volume_db_for(kind: String, speed: float) -> float:
	var sound: String = KIND_SOUNDS.get(kind, kind)
	if not LEVEL_DB.has(sound):
		return SILENT_DB
	var s := maxf(speed, MIN_SPEED)
	if sound == "pocket":
		s = sqrt(s * s + POCKET_DROP_SPEED * POCKET_DROP_SPEED)
	var ratio: float = s / FULL_SPEED[sound]
	var decades := log(ratio) / log(10.0)
	return LEVEL_DB[sound] + (15.0 if ratio <= 1.0 else 5.0) * decades


## Harder hits are shorter contacts and ring a little higher.
static func pitch_for(kind: String, speed: float) -> float:
	var sound: String = KIND_SOUNDS.get(kind, kind)
	var ratio: float = maxf(speed, 0.0) / FULL_SPEED.get(sound, 1.0)
	return 0.95 + 0.08 * sqrt(clampf(ratio, 0.0, 1.0))


static func roll_db_for(speed: float) -> float:
	return ROLL_MAX_DB + 20.0 * log(clampf(maxf(speed, MIN_SPEED) / ROLL_FULL_SPEED, 0.0, 1.0)) / log(10.0)


## The rolling sound's target level, SILENT_DB when nothing rolls.
func roll_level_db() -> float:
	return _roll_target_db


func active_voices() -> int:
	var now := Time.get_ticks_usec()
	var count := 0
	for end in _voice_end_usec:
		if end > now:
			count += 1
	return count


func _make_player(node_name: String) -> AudioStreamPlayer3D:
	var player := AudioStreamPlayer3D.new()
	player.name = node_name
	player.bus = &"Master"
	player.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	player.unit_size = UNIT_SIZE
	player.max_db = MAX_DB
	# The default distance low-pass would dull the clicks, which live above 2 kHz.
	player.attenuation_filter_cutoff_hz = 20500.0
	add_child(player)
	return player


func _pick_voice(db: float) -> int:
	var now := Time.get_ticks_usec()
	var quietest := -1
	for i in VOICES:
		if _voice_end_usec[i] <= now:
			return i
		if quietest < 0 or _voice_db[i] < _voice_db[quietest]:
			quietest = i
	return quietest if _voice_db[quietest] < db else -1


func _event_position(event: Dictionary, state: PackedFloat64Array, sound: String) -> Vector3:
	var count := state.size() / ShotPlayback.STRIDE
	var a := int(event.get("a", -1))
	if a < 0 or a >= count:
		if not _bad_event_logged:
			_bad_event_logged = true
			Log.warn("audio", "audio.error", {"sound": sound,
					"reason": "event %s names ball %d but the state has %d balls; played at the table centre"
							% [JSON.stringify(event), a, count]})
		return Vector3(0.0, _height, 0.0)
	var x := state[a * ShotPlayback.STRIDE + ShotPlayback.X]
	var y := state[a * ShotPlayback.STRIDE + ShotPlayback.Y]
	var b := int(event.get("b", -1))
	if String(event.get("kind", "")) == "ball_ball" and b >= 0 and b < count:
		x = (x + state[b * ShotPlayback.STRIDE + ShotPlayback.X]) / 2.0
		y = (y + state[b * ShotPlayback.STRIDE + ShotPlayback.Y]) / 2.0
	return TableSpace.core_to_godot(x, y, _height)


func _volume() -> float:
	return clampf(float(Settings.get_value("volume")), 0.0, 1.0)


# Loaded once per session; a failure logs once and the sound stays silent.
static func _stream(file: String) -> AudioStream:
	if _streams_by_name.has(file):
		return _streams_by_name[file]
	if _load_failed.has(file):
		return null
	var path := SOUND_DIR.path_join(file + ".wav")
	var reason := ""
	var stream: AudioStream = null
	if not ResourceLoader.exists(path):
		reason = "%s does not exist; run tools/make_sounds.py, then import the project" % path
	else:
		stream = load(path) as AudioStream
		if stream == null:
			reason = "%s did not load as an AudioStream" % path
	if stream == null:
		_load_failed[file] = true
		Log.warn("audio", "audio.error", {"sound": file, "reason": reason})
		return null
	_streams_by_name[file] = stream
	return stream
